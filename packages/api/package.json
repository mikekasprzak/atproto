{
  "name": "@atproto/api",
  "version": "0.15.16",
  "license": "MIT",
  "description": "Client library for atproto and Bluesky",
  "keywords": [
    "atproto",
    "bluesky",
    "api"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/api"
  },
  "config": {
    "outfile": "./dist/api.js",
    "infile": "src/index.ts",
    "esbuild_browser_options": "--platform=browser --bundle --minify --keep-names --sourcemap --format=esm --target=es2020"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "browser": "./dist/api.js",
    "require": "./dist/cjs/index.js",
    "import": "./dist/esm/index.js"
  },
  "scripts": {
    "codegen": "node ./scripts/generate-code.mjs && lex gen-api --yes ./src/client ../../lexicons/com/atproto/*/* ../../lexicons/app/bsky/*/* ../../lexicons/chat/bsky/*/* ../../lexicons/tools/ozone/*/*",
    "test": "jest",
    "clean": "rm -rf ./dist",
    "build": "$npm_execpath run build:node",
    "build:all": "$npm_execpath run clean && $npm_execpath run prebuild && $npm_execpath run build:node && $npm_execpath run build:browser",

    "prebuild": "../../tsconfig/makedist.sh",
    "build:cjs": "tsc --build tsconfig.cjs.json",
    "_build:esm": "tsc --build tsconfig.esm.json",
    "build:types": "tsc --build tsconfig.types.json",
    "build:node": "tsc --build tsconfig.cjs.json tsconfig.types.json",
    "build:browser": "esbuild ${npm_package_config_infile} ${npm_package_config_esbuild_browser_options} --outfile=${npm_package_config_outfile}",

    "prepublishOnly": "$npm_execpath run build:all"
  },
  "dependencies": {
    "@atproto/common-web": "workspace:^",
    "@atproto/lexicon": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "@atproto/xrpc": "workspace:^",
    "await-lock": "^2.2.2",
    "multiformats": "^9.9.0",
    "tlds": "^1.234.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@atproto/lex-cli": "workspace:^",
    "jest": "^28.1.2",
    "prettier": "^3.2.5",
    "typescript": "^5.6.3",
    "esbuild": "^0.25.0"
  }
}
