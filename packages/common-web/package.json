{
  "name": "@atproto/common-web",
  "version": "0.4.2",
  "license": "MIT",
  "description": "Shared web-platform-friendly code for atproto libraries",
  "keywords": [
    "atproto"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/common-web"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "browser": "./dist/common-web.js",
    "require": "./dist/cjs/index.js",
    "import": "./dist/esm/index.js"
  },
  "config": {
    "esbuild": "src/index.ts --bundle --sourcemap --minify --keep-names"
  },
  "scripts": {
    "test": "jest",
    "build": "$npm_execpath run build:node && $npm_execpath run build:browser",
    "build:clean": "rm -rf ./dist",
    "build:node": "tsc --build tsconfig.cjs.json tsconfig.esm.json tsconfig.types.json",
    "build:cjs": "tsc --build tsconfig.cjs.json",
    "build:esm": "tsc --build tsconfig.esm.json",
    "build:types": "tsc --build tsconfig.types.json",
    "build:browser": "esbuild src/index.ts --platform=browser --bundle --minify --keep-names --sourcemap --format=esm --target=es2020 --outfile=./dist/common-web.js"
  },
  "dependencies": {
    "graphemer": "npm:@mikekasprzak/graphemer@^1.4.1",
    "multiformats": "^9.9.0",
    "uint8arrays": "3.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^28.1.2",
    "typescript": "^5.6.3",
    "esbuild": "^0.25.0"
  }
}
