{
  "name": "@atproto/common",
  "version": "0.4.11",
  "license": "MIT",
  "description": "Shared web-platform-friendly code for atproto libraries",
  "keywords": [
    "atproto"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/common"
  },
  "main": "dist/node/index.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "exports": {
    "types": "dist/types/index.d.ts",
    "require": "dist/node/index.js",
    "import": "dist/nodenext/index.js",
    "default": "dist/nodenext/index.js"
  },
  "scripts": {
    "test": "jest",
    "build": "$npm_execpath run build:nodenext",
    "build:node": "tsc --build tsconfig.node.json",
    "build:nodenext": "tsc --build tsconfig.nodenext.json",
    "build:all": "tsc --build tsconfig.json"
  },
  "engines": {
    "node": ">=18.7.0"
  },
  "dependencies": {
    "@atproto/common-web": "workspace:^",
    "@ipld/dag-cbor": "^7.0.3",
    "cbor-x": "^1.5.1",
    "iso-datestring-validator": "^2.2.2",
    "multiformats": "^9.9.0",
    "pino": "^8.21.0"
  },
  "devDependencies": {
    "jest": "^28.1.2",
    "typescript": "^5.6.3",
    "uint8arrays": "3.0.0"
  }
}
