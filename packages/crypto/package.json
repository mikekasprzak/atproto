{
  "name": "@atproto/crypto",
  "version": "0.4.4",
  "license": "MIT",
  "description": "Library for cryptographic keys and signing in atproto",
  "keywords": [
    "atproto",
    "cryptography"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/crypto"
  },
  "config": {
    "outfile": "./dist/crypto.js",
    "infile": "src/index.ts",
    "esbuild_browser_options": "--platform=browser --bundle --minify --keep-names --sourcemap --format=esm --target=es2020"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "browser": "./dist/crypto.js",
    "require": "./dist/cjs/index.js",
    "import": "./dist/esm/index.js"
  },
  "scripts": {
    "test": "jest",
    "clean": "rm -rf ./dist",
    "build": "$npm_execpath run build:node",
    "build:all": "$npm_execpath run clean && $npm_execpath run prebuild &&$npm_execpath run build:node && $npm_execpath run build:browser",

    "prebuild": "../../tsconfig/makedist.sh",
    "build:cjs": "tsc --build tsconfig.cjs.json",
    "build:esm": "tsc --build tsconfig.esm.json",
    "build:types": "tsc --build tsconfig.types.json",
    "build:node": "tsc --build tsconfig.cjs.json tsconfig.esm.json tsconfig.types.json",
    "build:browser": "esbuild ${npm_package_config_infile} ${npm_package_config_esbuild_browser_options} --outfile=${npm_package_config_outfile}",

    "prepublishOnly": "$npm_execpath run build:all"
  },
  "engines": {
    "node": ">=18.7.0"
  },
  "dependencies": {
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "uint8arrays": "3.0.0"
  },
  "devDependencies": {
    "@atproto/common": "workspace:^",
    "jest": "^28.1.2",
    "typescript": "^5.6.3"
  }
}
