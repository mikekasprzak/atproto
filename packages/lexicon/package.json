{
  "name": "@atproto/lexicon",
  "version": "0.4.11",
  "license": "MIT",
  "description": "atproto Lexicon schema language library",
  "keywords": [
    "atproto",
    "lexicon"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/lexicon"
  },
  "config": {
    "outfile": "./dist/lexicon.js",
    "infile": "src/index.ts",
    "esbuild_browser_options": "--platform=browser --bundle --minify --keep-names --sourcemap --format=esm --target=es2020"
  },
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "type": "module",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "require": "./dist/cjs/index.js",
    "import": "./dist/esm/index.js"
  },
  "scripts": {
    "test": "jest",
    "build": "$npm_execpath run build:node && $npm_execpath run build:browser",
    "build:clean": "rm -rf ./dist",
    "build:node": "tsc --build tsconfig.cjs.json tsconfig.esm.json tsconfig.types.json",
    "build:cjs": "tsc --build tsconfig.cjs.json",
    "build:esm": "tsc --build tsconfig.esm.json",
    "build:types": "tsc --build tsconfig.types.json",
    "build:browser": "esbuild ${npm_package_config_infile} ${npm_package_config_esbuild_browser_options} --outfile=${npm_package_config_outfile}"
  },
  "dependencies": {
    "@atproto/common-web": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "iso-datestring-validator": "^2.2.2",
    "multiformats": "^9.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^28.1.2",
    "typescript": "^5.6.3",
    "esbuild": "^0.25.0"
  }
}
