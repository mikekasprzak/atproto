{
    "name": "@mikekasprzak/pds-activitypub",
    "version": "0.0.1",
    "license": "MIT",
    "description": "",
    "keywords": [
      "atproto",
      "activitypub",
      "bluesky"
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/bluesky-social/pds-activitypub",
      "directory": "packages/pds-activitypub"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
      "codegen": "ROOT=../..; IN=$ROOT/dist/lexicons; $ROOT/lexicons/generate.sh -qV $IN $ROOT/lexicons && lex gen-server --yes ./src/lexicon $IN/com/atproto/*/* $IN/app/bsky/*/* $IN/org/*/*/*",
      "build": "tsc --build tsconfig.build.json",
      "start": "node --enable-source-maps dist/bin.js",
      "migration:create": "ts-node ./bin/migration-create.ts",
      "buf:gen": "buf generate ../bsync/proto && buf generate ./proto"
    },
    "engines": {
      "node": ">=18.7.0"
    },
    "dependencies": {
      "@atproto/bsky": "workspace:*",
      "@atproto/lexicon": "workspace:*",
      "@atproto/oauth-provider": "workspace:*",
      "@atproto/xrpc-server": "workspace:*",
      "express": "^4.17.2",
      "multiformats": "^9.9.0",
      "@didtools/multidid": "^0.1.0"
    },
    "devDependencies": {
      "@atproto/lex-cli": "workspace:^",
      "@atproto/pds": "workspace:@mikekasprzak/pds@*",
      "ts-node": "^10.8.2",
      "typescript": "^5.6.3"
    }
  }
