{
  "name": "@atproto/syntax",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Validation for atproto identifiers and formats: DID, handle, NSID, AT URI, etc",
  "keywords": [
    "atproto",
    "did",
    "nsid",
    "at-uri"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/syntax"
  },
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "type": "module",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "require": "./dist/cjs/index.js",
    "import": "./dist/esm/index.js"
  },
  "scripts": {
    "test": "jest",
    "build": "$npm_execpath run build:node && $npm_execpath run build:browser",
    "build:clean": "rm -rf ./dist",
    "build:node": "tsc --build tsconfig.cjs.json tsconfig.esm.json tsconfig.types.json",
    "build:cjs": "tsc --build tsconfig.cjs.json",
    "build:esm": "tsc --build tsconfig.esm.json",
    "build:types": "tsc --build tsconfig.types.json",
    "build:browser": "esbuild src/index.ts --platform=browser --bundle --minify --keep-names --sourcemap --format=esm --target=es2020 --outfile=./dist/syntax.js"
  },
  "devDependencies": {
    "jest": "^28.1.2",
    "typescript": "^5.6.3"
  },
  "browser": {
    "dns/promises": false
  }
}
