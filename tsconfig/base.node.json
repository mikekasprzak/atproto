{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "CommonJS",
    "target": "ES2023",
    "lib": ["ES2023", "ScriptHost"],
    "types": ["node"],

    "esModuleInterop": true,
    "isolatedModules": true
  }
}
